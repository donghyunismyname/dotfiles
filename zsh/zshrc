# ============================================
# Completion
# ============================================

ZSH_PLUGINS="${ZSH_PLUGINS:-$HOME/.zsh/plugins}"

# MSYS2: autoloading a function searches all ~20 fpath dirs at ~5ms per
# function, so the first Tab took ~0.5s. Compile every fpath function into one
# digest placed first in fpath; rebuild when any fpath dir changes.
if [[ $OSTYPE == (cygwin|msys) ]]; then
    _fpath_zwc=$HOME/.cache/zsh/fpath.zwc
    _fpath_new=(${^fpath}(N/e:'[[ $REPLY -nt $_fpath_zwc ]]':))
    if [[ ! -s $_fpath_zwc ]] || (( $#_fpath_new )); then
        typeset -A _fpath_fns
        for _f in ${^fpath}/*(N.); do
            [[ $_f == *.zwc || -n $_fpath_fns[${_f:t}] ]] || _fpath_fns[${_f:t}]=$_f
        done
        mkdir -p ${_fpath_zwc:h}
        zcompile -Uz $_fpath_zwc ${(v)_fpath_fns}
        unset _fpath_fns _f
    fi
    fpath=($_fpath_zwc $fpath)
    unset _fpath_zwc _fpath_new
fi

autoload -Uz compinit
# -u skips the insecure-directory check (shared linuxbrew owns site-functions
# as another user). Same effect as omz's ZSH_DISABLE_COMPFIX.
compinit -u

# Source the init script a tool prints (`zoxide init zsh`, ...), cached until
# the tool's binary changes. A process spawn costs ~50ms on MSYS2, and these
# would otherwise run on every shell start. Delete ~/.cache/zsh to regenerate.
_cached_init() {
    local bin=${commands[$1]} cache=$HOME/.cache/zsh/$1.zsh
    [[ -n $bin ]] || return 0
    if [[ ! -s $cache || $cache -ot $bin ]]; then
        mkdir -p ${cache:h}
        "$@" >| $cache 2>/dev/null
    fi
    source $cache
}

# Highlighted, arrow-navigable completion menu (was provided by omz).
zstyle ':completion:*' menu select
# Color completion entries by file type using LS_COLORS.
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
# Fuzzy matching: case-insensitive, then partial at .-_ boundaries, then substring.
zstyle ':completion:*' matcher-list \
    'm:{a-zA-Z}={A-Za-z}' \
    'r:|[._-]=* r:|=*' \
    'l:|=* r:|=*'
# Shift-Tab cycles the completion menu backward.
bindkey '^[[Z' reverse-menu-complete


# ============================================
# Plugins
# ============================================

# Source a plugin, or warn instead of failing silently (a missing plugin is
# otherwise invisible: no error, the feature is just gone).
_load_plugin() {
    local f="$ZSH_PLUGINS/$1/$1.zsh"
    if [[ -f "$f" ]]; then
        source "$f"
    else
        print -u2 "zshrc: $1 not found in $ZSH_PLUGINS — run install-shell.sh"
    fi
}

_load_plugin zsh-autosuggestions
# MSYS2: async mode forks per keystroke (~45ms each); sync search takes ~1ms
[[ $OSTYPE == (cygwin|msys) ]] && unset ZSH_AUTOSUGGEST_USE_ASYNC
# zsh-syntax-highlighting must be sourced last
_load_plugin zsh-syntax-highlighting

unfunction _load_plugin


# ============================================
# Prompt (replicates the oh-my-zsh "dst" theme)
# ============================================

ZSH_THEME_GIT_PROMPT_PREFIX=" %{$fg[green]%}"
ZSH_THEME_GIT_PROMPT_SUFFIX="%{$reset_color%}"
ZSH_THEME_GIT_PROMPT_DIRTY="%{$fg[red]%}!"
ZSH_THEME_GIT_PROMPT_CLEAN=""

# One git call per prompt: branch and dirty state both come from status v2.
git_prompt_info() {
    local st
    st=$(command git status --porcelain=v2 --branch --ignore-submodules 2>/dev/null) || return 0
    local lines=("${(@f)st}")
    local ref=${${(M)lines:#\# branch.head *}#\# branch.head }
    # Detached HEAD: show the short commit hash instead
    if [[ $ref == '(detached)' ]]; then
        ref=${${(M)lines:#\# branch.oid *}#\# branch.oid }
        ref=${ref[1,7]}
    fi
    # Lines not starting with '#' are changed or untracked files
    local changed=(${lines:#\#*}) dirty=""
    (( $#changed )) && dirty="$ZSH_THEME_GIT_PROMPT_DIRTY"
    echo "${ZSH_THEME_GIT_PROMPT_PREFIX}${ref}${dirty}${ZSH_THEME_GIT_PROMPT_SUFFIX}"
}

prompt_char() {
    if [ $UID -eq 0 ]; then echo "%{$fg[red]%}#%{$reset_color%}"; else echo '$'; fi
}

# Async git info: the prompt shows at once and the branch fills in when
# git_prompt_info finishes in the background (~100ms per call on Windows).
_git_prompt=""
_git_prompt_fd=""
_git_prompt_dir=""

_git_prompt_start() {
    # Drop a request still running from the previous prompt
    if [[ -n $_git_prompt_fd ]]; then
        zle -F $_git_prompt_fd 2>/dev/null
        exec {_git_prompt_fd}<&-
    fi
    # Keep the last value in the same directory; clear it after a cd
    [[ $PWD == $_git_prompt_dir ]] || _git_prompt=""
    _git_prompt_dir=$PWD
    exec {_git_prompt_fd}< <(git_prompt_info)
    zle -F $_git_prompt_fd _git_prompt_done
}

_git_prompt_done() {
    local out
    IFS= read -r -u $1 out
    zle -F $1
    exec {_git_prompt_fd}<&-
    _git_prompt_fd=""
    if [[ $out != $_git_prompt ]]; then
        _git_prompt=$out
        zle reset-prompt
    fi
}

autoload -Uz add-zsh-hook
add-zsh-hook precmd _git_prompt_start

PROMPT='%(?, ,%{$fg[red]%}FAIL%{$reset_color%}
)
%{$fg[magenta]%}%n%{$reset_color%}@%{$fg[yellow]%}%m%{$reset_color%}: %{$fg_bold[blue]%}%~%{$reset_color%}${_git_prompt}
$(prompt_char) '

RPROMPT='%{$fg[green]%}[%*]%{$reset_color%}'


