# ============================================
# Functions
# ============================================

# Who git will commit as, and where each identity-related setting comes from.
# Later lines override earlier ones (system < global < local).
gwho() {
  git config --list --show-origin --show-scope \
    | grep -E '\b(user|include|includeIf|gpg|credential)\.|\.gpgsign=' \
    | awk -F'\t' -v OFS='\t' '{ print $1, $3, $2 }' \
    | column -t -s $'\t'
  echo
  echo "effective: $(git config user.name) <$(git config user.email)>"
}

# interactive git checkout with fzf
gcoi() {
  git branch --all --format='%(refname:short)' | fzf | xargs git checkout
}

# inline git commit with message
gcm() {
  if [[ $# -eq 0 ]]; then
    echo -n "Commit message: "
    read -r msg
    git commit -m "$msg"
  else
    git commit -m "$*"
  fi
}

# Open with the OS default app (file manager for directories), like z/zi:
#   e            current directory
#   e <path>     that directory, or that file in its default app
#   e <words>    best zoxide match for the words
#   ei [words]   pick a zoxide match with fzf
#   et [words]   pick a file like CTRL-T (current directory)
#   eg [words]   pick a file like CTRL-G (home)
# Refuses over SSH, where the window would appear on the remote machine's
# screen instead of yours.
e() {
  _e_can_open || return
  if (( $# <= 1 )) && [[ -e ${1:-.} ]]; then
    _e_open ${1:-.}
  else
    _e_zoxide -- "$@"
  fi
}

ei() {
  _e_can_open && _e_zoxide -i -- "$@"
}

et() { _e_pick "$FZF_CTRL_T_COMMAND" "$FZF_CTRL_T_OPTS" "$@" }
eg() { _e_pick "$FZF_CTRL_G_COMMAND" "$FZF_CTRL_G_OPTS" "$@" }

# _e_pick <list command> <fzf options> [query]
_e_pick() {
  _e_can_open || return
  local cmd=$1 opts=$2 file
  shift 2
  # Same layout flags fzf's own CTRL-T widget adds before FZF_CTRL_T_OPTS
  file=$(eval "$cmd" | FZF_DEFAULT_OPTS="--height 40% --reverse --scheme=path $FZF_DEFAULT_OPTS $opts" fzf --query="$*") || return
  _e_open $file
}

_e_can_open() {
  if [[ -n $SSH_CONNECTION ]]; then
    print -u2 "e: SSH session, no local desktop to open it on"
    return 1
  fi
  if [[ $OSTYPE == linux* && -z $WSL_DISTRO_NAME && -z $DISPLAY$WAYLAND_DISPLAY ]]; then
    print -u2 "e: no graphical session (DISPLAY and WAYLAND_DISPLAY are unset)"
    return 1
  fi
}

_e_zoxide() {
  local dir
  dir=$(zoxide query "$@") || return
  _e_open $dir
}

# MSYS2: paths may come in Windows form (C:\... from zoxide, C:/... from the
# CTRL-T list), which zsh's :A would treat as relative; cygpath -a takes both.
_e_open() {
  local target=${1:A}
  if [[ $OSTYPE == darwin* ]]; then
    open $target
  elif [[ $OSTYPE == (cygwin|msys) || -n $WSL_DISTRO_NAME ]]; then
    local win
    if [[ -n $WSL_DISTRO_NAME ]]; then win=$(wslpath -w $target); else win=$(cygpath -aw $1); fi
    # explorer.exe exits 1 even on success, so ignore its status.
    explorer.exe $win
    return 0
  else
    xdg-open $target
  fi
}


