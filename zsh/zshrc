# Directory navigation: expand ... as a command argument, e.g. `cd ...`.
# Global aliases (-g) expand anywhere on the line, not just command position.
# `..` needs no alias since it is already a real path (`cd ..` works).
alias -g ...='../..'
alias -g ....='../../..'
alias -g .....='../../../..'
alias -g ......='../../../../..'

# AI agents run inside a memory-capped cgroup (systemd/agents.slice).
# Children (lean, lake, node, ...) inherit the slice. No-op on macOS.
if command -v systemd-run >/dev/null 2>&1 && [[ -d /run/user/$UID ]]; then
    _agent() { systemd-run --user --quiet --scope --slice=agents.slice "$@" }
    alias claude='_agent claude'
    alias codex='_agent codex'
fi

