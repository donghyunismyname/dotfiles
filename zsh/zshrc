# fzf (0.48+ prints its own key bindings and completion)
_cached_init fzf --zsh

# Use fd for fzf: fast, respects .gitignore, includes hidden files
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
# CTRL-T searches the current directory, CTRL-G all of home; both list
# recently modified files first. On equal fuzzy scores --tiebreak=index keeps
# that order, and the same key again drops fuzzy ranking entirely (like fzf's
# own CTRL-R widget does with ctrl-r:toggle-sort).
_fzf_dir=${${(%):-%x}:A:h}
export FZF_CTRL_T_COMMAND="sh '$_fzf_dir/recent-files.sh' --exclude .git"
FZF_CTRL_G_COMMAND="sh '$_fzf_dir/recent-files.sh' --ignore-file '$_fzf_dir/fzf-home.ignore' . '$HOME'"
unset _fzf_dir

# Preview file content using bat (https://github.com/sharkdp/bat)
_fzf_file_opts="
  --tiebreak=index
  --preview 'bat -n --color=always {}'
  --bind 'ctrl-/:change-preview-window(down|hidden|)'
  --color header:italic"
export FZF_CTRL_T_OPTS="$_fzf_file_opts
  --bind 'ctrl-t:toggle-sort'
  --header 'CTRL-T: toggle recent-first order'"
FZF_CTRL_G_OPTS="$_fzf_file_opts
  --bind 'ctrl-g:toggle-sort'
  --header 'CTRL-G: toggle recent-first order'"
unset _fzf_file_opts

# CTRL-G: fzf's CTRL-T widget with the home list and options
fzf-home-widget() {
  FZF_CTRL_T_COMMAND=$FZF_CTRL_G_COMMAND FZF_CTRL_T_OPTS=$FZF_CTRL_G_OPTS fzf-file-widget
}
zle -N fzf-home-widget
bindkey '^G' fzf-home-widget

# CTRL-/ to toggle small preview window to see the full command
# CTRL-Y to copy the command into clipboard (pbcopy; /dev/clipboard on MSYS2)
_fzf_copy=pbcopy
[[ $OSTYPE == (cygwin|msys) ]] && _fzf_copy='cat > /dev/clipboard'
export FZF_CTRL_R_OPTS="
  --preview 'echo {}' --preview-window up:3:hidden:wrap
  --bind 'ctrl-/:toggle-preview'
  --bind 'ctrl-y:execute-silent(echo -n {2..} | $_fzf_copy)+abort'
  --color header:italic
  --header 'Press CTRL-Y to copy command into clipboard'"
unset _fzf_copy

# ff - fuzzy line search with bat previews
#   ff [dir] [query]     lines of every file under dir (default .),
#                        matching the file name and the line together
#   ff <file> [query]    lines of one file
#   <cmd> | ff [query]   lines of stdin; ENTER prints the line
# ENTER opens the line in vim. A first argument that is no path starts the
# query. An empty query lists lines in order, so one file reads like a pager.
# CTRL-S toggles best-match-first order, CTRL-Y copies the line,
# CTRL-/ toggles the context preview.
# (zsh/ff.sh, the0807/ff's file finder that ff used to be, is kept unsourced.)
ff() {
  local file dir src out f n text copy=pbcopy
  [[ $OSTYPE == (cygwin|msys) ]] && copy='cat > /dev/clipboard'
  if [[ ! -t 0 ]]; then
    src=$(mktemp)
    cat > $src
  elif [[ -f $1 ]]; then
    file=$1 src=$1; shift
  else
    dir=.
    [[ -d $1 ]] && { dir=$1; shift }
  fi
  # fzf fields: line, text for one file; file, line, text for a directory
  local fp=${(q)src} lp='{1}' tp='{2..}' nth=2..
  [[ -n $dir ]] && fp='{1}' lp='{2}' tp='{3..}' nth=1,3..
  # vim runs after fzf exits, not via become(): Windows fzf hands become()
  # its piped stdin, so vim would not get the terminal.
  {
    out=$(
      if [[ -n $dir ]]; then
        # '\S' skips blank lines; ${dir:#.} keeps paths free of a ./ prefix.
        # MSYS would turn the lone / into C:/msys64/, so exclude that flag.
        MSYS2_ARG_CONV_EXCL=--path-separator \
        rg --line-number --with-filename --no-heading \
          --color=always --colors=match:none \
          --hidden --glob='!.git' --path-separator=/ \
          --field-match-separator=$'\t' '\S' ${dir:#.}
      else
        bat --color=always --style=plain --paging=never -- $src |
          awk '{ printf "\033[2m%5d\033[0m\t%s\n", NR, $0 }'
      fi |
      fzf --ansi --delimiter='\t' --nth=$nth --tiebreak=index --layout=reverse --wrap \
        --query="$*" \
        --preview "bat --color=always --style=numbers --highlight-line $lp -- $fp" \
        --preview-window "up,70%,wrap,border-bottom,+$lp-/2" \
        --bind 'ctrl-s:toggle-sort' \
        --bind 'ctrl-/:change-preview-window(hidden|)' \
        --bind "ctrl-y:execute-silent(echo -n $tp | $copy)+abort") || return
    if [[ -n $dir ]]; then
      IFS=$'\t' read -r f n text <<< $out
    else
      IFS=$'\t' read -r n text <<< $out
      f=$file
    fi
    if [[ -n $f ]]; then vim +$((n)) -- $f; else print -r -- $text; fi
  } always {
    [[ -z $file$dir ]] && rm -f $src
  }
}


